PORT=3000
# Allowed browser origin(s) for CORS; separate several with commas
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://retain_user:change_me@localhost:5432/retain

# Secret used to sign login tokens
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# Token lifetime in seconds (default: 7 days)
JWT_EXPIRES_IN_SECONDS=604800

# Administrator account created by `npm run db:seed` (skipped if either is unset)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-before-seeding

# Sign-in/sign-up attempts allowed per address every 15 minutes (default 30)
AUTH_RATE_LIMIT_MAX=30

# Optional demo account with sample expenses and budgets (skipped if either is unset)
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-before-seeding
